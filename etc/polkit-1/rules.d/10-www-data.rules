//Rule #14
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/home/pinodexmr/enable-swap.sh" &&
        subject.user == "www-data") {
        return polkit.Result.YES;
    }
});

//Rule #15
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/home/pinodexmr/disable-swap.sh" &&
        subject.user == "www-data") {
        return polkit.Result.YES;
    }
});

//Rule #15
polkit.addRule(function(action, subject) {
    if (subject.user == "www-data") {
        
        if (action.id == "org.freedesktop.systemd1.manage-units") {
            var unitName = action.lookup("unit");
            if (unitName == "bootStatusSetIdle.service") {
                return polkit.Result.YES;
            }
        }
    }
});
